---
// /__edit/<collection>/<id>: the editor, inside the site's own Shell (layout + Prose).
import Shell from 'virtual:mdx-editor/shell';
import * as globals from 'virtual:mdx-editor/globals';
import { callouts, emoji, imagesOn, keymap, loadEntry, pageUrl, token, typography } from 'virtual:mdx-editor/server';

const { collection = '', id = '' } = Astro.params;
const entry = await loadEntry(collection, id);
if (!entry) return new Response(`No entry ${collection}/${id}`, { status: 404 });

// Keep the globals in this page's module graph, so the components' scoped CSS loads in dev.
void globals;

const config = {
    collection,
    id,
    token,
    hash: entry.hash,
    pageUrl: pageUrl(collection, id),
    typography,
    keymap,
    callouts,
    emoji,
    images: imagesOn(collection),
    fileBase: entry.fileBase,
};
// JSON inside <script> must not be able to close the tag.
const json = (value: unknown) => JSON.stringify(value).replace(/</g, '\\u003c');
---

<Shell collection={collection} id={id}>
    <div id='mdx-editor' class='mdx-editor'></div>
    <script type='application/json' id='mdx-editor-config' set:html={json(config)} />
    <script type='application/json' id='mdx-editor-doc' set:html={json(entry.text)} />
</Shell>

<script>
    import '../client/main.ts';
</script>
