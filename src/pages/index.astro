---
// /__edit: every entry the editor can open, and a form per collection for a new one.
import { entries, pageUrl, token } from 'virtual:mdx-editor/server';

const list = await entries();
const byCollection = Map.groupBy(list, (e: { collection: string }) => e.collection);
---

<!doctype html>
<html lang='en'>
    <head>
        <meta charset='utf-8' />
        <meta name='viewport' content='width=device-width, initial-scale=1' />
        <meta name='robots' content='noindex' />
        <title>Editor</title>
        <style>
            /* The editor's own page, not the site's: neutral, from the browser's system colours. */
            :root {
                color-scheme: light dark;
                --muted: color-mix(in srgb, CanvasText 60%, Canvas);
                --rule: color-mix(in srgb, CanvasText 14%, Canvas);
            }
            body {
                max-width: 40rem;
                margin: 3rem auto;
                padding: 0 1rem;
                font:
                    16px/1.6 system-ui,
                    sans-serif;
                color: CanvasText;
                background: Canvas;
            }
            h1 {
                font-size: 1.5rem;
            }
            h2 {
                margin-top: 2rem;
                font-size: 1rem;
                text-transform: capitalize;
                color: var(--muted);
            }
            ul {
                padding: 0;
                list-style: none;
            }
            li {
                display: flex;
                gap: 1rem;
                padding: 0.4rem 0;
                border-bottom: 1px solid var(--rule);
            }
            a {
                color: LinkText;
            }
            form {
                display: flex;
                gap: 0.5rem;
                margin: 0.5rem 0 1rem;
            }
            form input {
                flex: 1;
                padding: 0.35rem 0.6rem;
                border: 1px solid var(--rule);
                border-radius: 6px;
                font: inherit;
                color: inherit;
                background: transparent;
            }
            form button {
                padding: 0.35rem 0.9rem;
                border: 0;
                border-radius: 6px;
                font: inherit;
                color: AccentColorText;
                background: AccentColor;
                cursor: pointer;
            }
            .error {
                color: color-mix(in srgb, red 70%, CanvasText);
                font-size: 0.875rem;
            }
            .page {
                margin-left: auto;
                color: var(--muted);
                font-size: 0.875rem;
            }
        </style>
    </head>
    <body>
        <h1>Editor</h1>
        {
            [...byCollection].map(([collection, items]) => (
                <section>
                    <h2>{collection}</h2>
                    <form data-collection={collection}>
                        <input name='title' placeholder={`Title of a new ${collection.replace(/s$/, '')}`} required />
                        <button>New</button>
                    </form>
                    <ul>
                        {items.map((e: { collection: string; id: string }) => {
                            const url = pageUrl(e.collection, e.id);
                            return (
                                <li>
                                    <a href={`/__edit/${e.collection}/${e.id}`}>{e.id}</a>
                                    {url && (
                                        <a class='page' href={url}>
                                            page
                                        </a>
                                    )}
                                </li>
                            );
                        })}
                    </ul>
                </section>
            ))
        }
        <script type='application/json' id='mdx-editor-token' set:html={JSON.stringify(token)} />
        <script>
            // A new entry: the server writes it from the site's template, then the editor opens it.
            const token = JSON.parse(document.getElementById('mdx-editor-token')!.textContent!);
            let creating = false;
            // Like an editor tab, take reloads as events (src/server/reload.ts), so making an entry
            // doesn't reload this page before the editor opens.
            const hot = import.meta.hot;
            if (hot) {
                const hello = () => hot.send('mdx-editor:hello', {});
                hello();
                hot.on('vite:ws:connect', hello);
                hot.on('mdx-editor:full-reload', (data: { kind: string }) => {
                    if (data.kind !== 'content' || !creating) location.reload();
                });
            }
            for (const form of document.querySelectorAll<HTMLFormElement>('form[data-collection]')) {
                form.addEventListener('submit', async (e) => {
                    e.preventDefault();
                    creating = true;
                    const title = (form.elements.namedItem('title') as HTMLInputElement).value;
                    const r = await fetch('/__edit/api/new', {
                        method: 'POST',
                        headers: { 'content-type': 'application/json', 'x-mdx-editor-token': token },
                        body: JSON.stringify({ collection: form.dataset.collection, title }),
                    });
                    const body = await r.json();
                    if (r.ok) location.href = `/__edit/${body.collection}/${body.id}`;
                    else {
                        creating = false;
                        form.querySelector('.error')?.remove();
                        form.insertAdjacentHTML('beforeend', '<span class="error"></span>');
                        form.querySelector('.error')!.textContent = body.error ?? `Failed (${r.status})`;
                    }
                });
            }
        </script>
    </body>
</html>
