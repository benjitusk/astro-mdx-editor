{
    "compilerOptions": {
        "target": "ES2024",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": ["ES2024", "DOM", "DOM.Iterable"],
        "strict": true,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "erasableSyntaxOnly": true,
        "skipLibCheck": true,
        "types": ["node", "vite/client"]
    },
    "include": ["src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"]
}
